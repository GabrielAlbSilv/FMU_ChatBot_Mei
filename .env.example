GROQ_API_KEY="cole_sua_chave_aqui"

# Opcional: modelo de embeddings multilíngue (entende muito melhor perguntas em
# português; usa ~250 MB a mais de RAM). O índice é reconstruído sozinho ao trocar.
# MODELO_EMBEDDINGS="sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"

# Opcional: desliga a reescrita da pergunta pelo LLM antes da busca (0 = desliga)
# REESCREVER_CONSULTA=1
