GROQ_API_KEY="cole_sua_chave_aqui"

# Opcional: modelo de embeddings multilíngue (entende muito melhor perguntas em
# português; usa ~250 MB a mais de RAM). O índice é reconstruído sozinho ao trocar.
# MODELO_EMBEDDINGS="sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"

# Conferência das respostas com os sites do Sebrae e da Receita Federal (1 = liga, 0 = desliga).
# Compara a resposta feita com os PDFs com essas duas fontes e, se algo estiver desatualizado,
# gera uma nova resposta com base nos sites. Só esses dois sites são aceitos (ver verificador.py).
# VERIFICAR_SITES=1
# Usa o DuckDuckGo só para descobrir endereços DENTRO desses sites (0 = usa só fontes_oficiais.json)
# VERIFICAR_BUSCA_DESCOBERTA=1
# Modelo da comparação (padrão: o mesmo MODELO_LLM)
# MODELO_VERIFICACAO=openai/gpt-oss-120b

# Opcional: desliga a reescrita da pergunta pelo LLM antes da busca (0 = desliga)
# REESCREVER_CONSULTA=1
