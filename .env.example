# Lista completa (com os valores padrão) em config.py — este arquivo é o resumo para quem configura.
GROQ_API_KEY="cole_sua_chave_aqui"

# ---------------------------------------------------------------- segurança e limites
# Perguntas por IP e de TODAS as pessoas juntas por janela de tempo (protege a cota da Groq)
# LIMITE_POR_IP=15
# LIMITE_GLOBAL=60
# JANELA_SEGUNDOS=60
# Cabeçalho com o IP real (no Render, o Cloudflare preenche True-Client-IP). O X-Forwarded-For não é usado.
# CABECALHO_IP=True-Client-IP
# Senha para ver os detalhes técnicos e as métricas em /api/status (cabeçalho X-Token).
# Sem ela, vale o BASE_WEB_TOKEN. No Render, o render.yaml gera uma sozinho.
# STATUS_TOKEN=uma_senha_comprida
# Modelo usado quando a Groq recusa o principal por limite de uso (429); vazio = sem reserva
# MODELO_RESERVA=openai/gpt-oss-20b
# PAUSA_RESERVA_S=60

# ---------------------------------------------------------------- banco de dados (opcional)
# PostgreSQL (ex.: Neon gratuito) para guardar respostas, votos e avaliações. Passo a passo: docs/BANCO.md
# DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require
# Dias que as perguntas (já sem dados pessoais) ficam guardadas
# RETENCAO_DIAS=180

# Tamanho máximo da pergunta (caracteres)
# TAMANHO_MAX_PERGUNTA=1000

# Opcional: modelo de embeddings multilíngue (entende muito melhor perguntas em
# português; usa ~250 MB a mais de RAM). O índice é reconstruído sozinho ao trocar.
# Antes de trocar no Render (512 MB no plano gratuito), meça: python avaliar_busca.py <modelo>
# MODELO_EMBEDDINGS="sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"

# Conferência das respostas com os sites do Sebrae e da Receita Federal (1 = liga, 0 = desliga).
# Compara a resposta feita com os PDFs com essas duas fontes e, se algo estiver desatualizado,
# gera uma nova resposta com base nos sites. Só esses dois sites são aceitos (ver verificador.py).
# VERIFICAR_SITES=1
# Usa o DuckDuckGo só para descobrir endereços DENTRO desses sites. Padrão 0: ele bloqueia servidores
# (anti-robô). A descoberta de páginas para qualquer pergunta é feita por pesquisa.py (sitemaps + busca interna).
# VERIFICAR_BUSCA_DESCOBERTA=0
# Pesquisa geral nos sites oficiais (1 = liga) e rigor para "a página trata do assunto" (0 a 1)
# PESQUISA_ATIVA=1
# PESQUISA_LIMIAR=0.5
# Modelo da comparação (padrão: o mesmo MODELO_LLM)
# MODELO_VERIFICACAO=openai/gpt-oss-120b

# Opcional: desliga a reescrita da pergunta pelo LLM antes da busca (0 = desliga)
# REESCREVER_CONSULTA=1
# A reescrita também sugere dados (faturamento, mês de abertura, atividade). O código só aceita o que
# confirmar no texto do usuário. 0 = usa só as regras de texto.
# EXTRAIR_DADOS_LLM=1
# Máximo de trechos (de 8) que um mesmo PDF pode ocupar (perguntas de Imposto de Renda: sem limite)
# MAX_TRECHOS_POR_PDF=5

# ---------------------------------------------------------------- velocidade
# Modelo da reescrita da pergunta (rápido). Se a Groq recusar, o bot usa o MODELO_LLM sozinho.
# MODELO_REESCRITA=openai/gpt-oss-20b
# Quanto o modelo "pensa" antes de responder: low (rápido, padrão) | medium | high
# ESFORCO_RESPOSTA=low
# Conferência com os sites: "depois" (padrão: a resposta aparece na hora e é conferida em seguida;
# se estiver desatualizada, é trocada pela corrigida) ou "antes" (só mostra depois de conferir).
# CONFERENCIA_MODO=depois

# ------------------------------------------- base sempre atualizada (sites e PDFs oficiais)
# Coleta periódica das páginas do Sebrae e da Receita Federal (base_web.py) — fontes_oficiais.json
# BASE_WEB_ATIVA=1
# BASE_WEB_HORAS=12
# BASE_WEB_MAX_PAGINAS=80
# Confere se os PDFs da base têm versão mais nova no site e já usa a nova (sem esperar deploy)
# BASE_WEB_PDFS=1
# Páginas oficiais recentes que entram junto com os PDFs em cada resposta (0 = nenhuma)
# WEB_NA_RESPOSTA=2
# Senha para o GitHub Actions pedir uma coleta agora (POST /api/base-web/atualizar, cabeçalho X-Token)
# BASE_WEB_TOKEN=uma_senha_comprida
# No build (preparar_base.py): baixar PDFs novos e fazer a 1ª coleta dos sites (1 = sim)
# ATUALIZAR_PDFS_NO_BUILD=1
# COLETAR_WEB_NO_BUILD=1

# ---------------------------------------------------------------- voz
# Transcrição da pergunta falada (Groq Whisper). Se a Groq recusar o modelo, usa whisper-large-v3.
# MODELO_TRANSCRICAO=whisper-large-v3-turbo
# Tamanho máximo do áudio enviado (MB)
# MAX_MB_AUDIO=6
# (A leitura das respostas em voz alta e a tradução para Libras — VLibras — rodam no navegador.)
